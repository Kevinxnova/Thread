# Default deny: only reviewed project files may be staged.
/*
!/.gitignore
!/AGENTS.md
!/Package.swift
!/README.md
!/README.en.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/Sources/
/Sources/**
!/Sources/**/
!/Sources/**/*.swift
!/Tests/
/Tests/**
!/Tests/**/
!/Tests/**/*.swift
!/scripts/
/scripts/*
!/scripts/build.sh
!/scripts/make-icon.swift
!/scripts/check-repository.py
!/scripts/test-repository-check.py
!/docs/
/docs/*
!/docs/REQUIREMENTS.md
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/pre-push
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml

# Runtime data and outputs remain private wherever they appear.
**/Thread_kevin/
**/Jev_kevin/
**/.thread/
**/笔记/
**/总览.md
**/验证/
**/dist/
**/.build/
**/.swiftpm/
**/.DS_Store
**/__pycache__/
*.log
*.jsonl
.env
.env.*
*.pem
*.key
*.p12
*.mobileprovision
